# Copy to .env. Loaded by the app only (python-dotenv / Next.js). Do NOT `export` these in your shell:
# an exported ANTHROPIC_API_KEY makes Claude Code bill the API instead of your subscription.

# Anthropic Console, Individual org (the one with the credits). Leave blank to use MockExtractor/MockMargaret.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Cartesia (promo CARTESIACALHACKS). Leave blank for MockTTS via macOS `say`.
CARTESIA_API_KEY=
TTS_PROVIDER=mock          # mock | cartesia
STT_PROVIDER=mock          # mock | cartesia
CARTESIA_VOICE_ID=d7bf7d75-64b7-4c1e-86c0-79d647366587   # stock voice "Michelle", no cloning

# Capital One Nessie sandbox. Leave blank for MockNessie.
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com

# Room backend
ROOM_BACKEND=spacetime     # spacetime | memory
SPACETIME_URI=http://localhost:3000
SPACETIME_DB=second-key

# Kernel
KERNEL_URL=http://localhost:8000
DEMO_MODE=0                # 1 enables /payments/{id}/mutate, /audit/tamper and LLM cache replay
MOCK_EXTRACTOR=0           # 1 forces MockExtractor even if a key exists
POLICY_VERSION=v1

# Overnight agent behaviour
PUSH_OK=0                  # 1 lets the agent `git push origin` (never force). Private repo only.
