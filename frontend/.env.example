# Direct kernel origin (WebSocket, audio). REST is proxied through /kernel by default.
NEXT_PUBLIC_KERNEL_URL=http://localhost:8000
# Set to the kernel origin to skip the proxy once the kernel sends CORS headers.
# NEXT_PUBLIC_KERNEL_API=http://localhost:8000
NEXT_PUBLIC_ROOM_BACKEND=memory
NEXT_PUBLIC_SPACETIME_URI=ws://localhost:3000
NEXT_PUBLIC_SPACETIME_DB=second-key
